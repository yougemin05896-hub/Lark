<?xml version="1.0" encoding="utf-8"?>
<!-- activity_glass_player.xml: The massive, heavily detailed master UI layer -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Absolute Bottom Layer: The ExoPlayer Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/gradient_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating UI: Lock Screen Status Indicator -->
    <ImageView
        android:id="@+id/btn_lock_screen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_secure"
        android:padding="12dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_liquid_glass"
        android:tint="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
        
    <!-- Floating UI: Audio Tracks / Speed -->
    <ImageView
        android:id="@+id/btn_speed_float"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_recent_history"
        android:padding="12dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_liquid_glass"
        android:tint="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Central Massive Play/Pause Node (Video.js 1:1 Engine) -->
    <!-- Sharp background, separate vector for zero blur bleed -->
    <ImageView
        android:id="@+id/btn_center_play_pause"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_play_massive"
        android:background="@drawable/bg_liquid_glass"
        android:padding="24dp"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/compose_bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Central Gesture Feedback -->
    <TextView
        android:id="@+id/tv_gesture_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_liquid_glass"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ultimate Bottom Liquid Bar Overlay (Kyant0 Liquid Glass) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
