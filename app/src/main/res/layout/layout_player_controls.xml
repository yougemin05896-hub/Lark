<?xml version="1.0" encoding="utf-8"?>
<!-- layout_player_controls.xml: The deeply customized bottom nested control bar -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_liquid_glass"
    android:layout_marginHorizontal="16dp"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- The Razor Thin Timeline -->
    <SeekBar
        android:id="@+id/player_timeline"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:progressDrawable="@null"
        android:thumb="@null"
        android:splitTrack="false"
        android:background="#00000000"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#4DFFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Left Controls Group -->
    <LinearLayout
        android:id="@+id/left_controls_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/player_timeline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Play/Pause Toggle -->
        <ImageView
            android:id="@+id/btn_small_play_pause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_play_massive"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <!-- High-Contrast Time Elapsed -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 / 00:00"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Right Controls Group -->
    <LinearLayout
        android:id="@+id/right_controls_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="@id/left_controls_group"
        app:layout_constraintBottom_toBottomOf="@id/left_controls_group"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_volume"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_subtitles"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_dialog_info"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_fullscreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_crop"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
